@page "/profiles/{Id:guid}"
@implements IDisposable
@inject DeckLibrary Library
@inject CardCatalog Catalog
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>@(_profile?.Name ?? "Player") · Someone Else's Table</PageTitle>

<div class="page wide">
    <header class="page-head">
        <a href="profiles" class="back">← Players</a>
        <h1>
            @(string.IsNullOrWhiteSpace(_profile?.Name) ? "Player" : _profile.Name)
            @if (_profile is not null)
            {
                <span class="badge">@(_profile.UserId == Library.UserId ? "You" : _profile.IsClaimed ? "Signed in" : "Not signed in yet")</span>
            }
        </h1>
    </header>

    @if (Library.Profiles is null)
    {
        <AccountPanel />
    }
    else if (_profile is null)
    {
        @if (_loadError is not null) { <ErrorMessage Message="@_loadError" /> }
        else { <p class="muted">Loading player…</p> }
    }
    else
    {
        var stats = PlayerStats.For(_profile.Id, _games);
        var worth = DeckValue.Of(_profile.Collection, _cards);

        @if (_canManage)
        {
            <div class="row spread save-bar">
                <label class="field grow">
                    <span>Name</span>
                    <input @bind="_profile.Name" @bind:after="Touch" maxlength="60" aria-label="Player name" />
                </label>
                <div class="actions">
                    @if (_dirty) { <span class="unsaved small">Unsaved changes</span> }
                    <button @onclick="DeleteAsync">Delete</button>
                    <button class="primary" @onclick="SaveAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_profile.Name))">@(_saving ? "Saving…" : "Save")</button>
                </div>
            </div>
        }
        else
        {
            <p class="muted small">
                @(_profile.IsClaimed
                    ? $"Only {_profile.Name} can change this profile."
                    : "Only the person who made this profile can change it, until its player signs in and claims it.")
            </p>
        }
        <ErrorMessage Message="@_error" />

        @if (_canManage && !_profile.IsClaimed)
        {
            <section class="panel account">
                <h2>Invite @_profile.Name</h2>
                <p class="muted">
                    Give @_profile.Name this code. When they sign in for the first time, they can enter it to make this profile
                    theirs, with its collection, decks, playgroups and games. Each code works once.
                </p>
                @if (_claimCode is null)
                {
                    <div class="actions"><button @onclick="() => LoadClaimCodeAsync(false)" disabled="@_codeBusy">Show invite code</button></div>
                }
                else
                {
                    <div class="claim-code">
                        <code>@_claimCode</code>
                        <button class="icon" title="Copy invite code" aria-label="Copy invite code" @onclick="CopyClaimCodeAsync">⧉</button>
                        <button @onclick="ResetClaimCodeAsync" disabled="@_codeBusy" title="Make a new code; the old one stops working">New code</button>
                        @if (_copied) { <span class="muted">Copied!</span> }
                    </div>
                }
                <ErrorMessage Message="@_codeError" />
            </section>
        }

        <dl class="stat-row">
            <div><dt>Games</dt><dd>@stats.Games</dd></div>
            <div><dt>Wins</dt><dd>@stats.Wins</dd></div>
            <div><dt>Win rate</dt><dd>@(stats.WinRate is { } rate ? rate.ToString("P0") : "—")</dd></div>
            <div><dt>Cards owned</dt><dd>@_profile.CardCount</dd></div>
            <div title="@WorthTitle(worth)">
                <dt>Collection value</dt>
                <dd>@(_resolving ? "…" : DeckValue.FormatUsd(worth.Usd))</dd>
            </div>
            <div title="Every card in the decks this player owns, sideboards included. Cards in both a deck and the collection count in both.">
                <dt>Decks value</dt>
                <dd>@(_decksWorth is { } d ? DeckValue.FormatUsd(d.Usd) : "…")</dd>
            </div>
        </dl>

        <section class="profile-section">
            <div class="row spread">
                <h2>Decks <span class="muted">(@_decks.Count)</span></h2>
                @if (_canManage) { <a class="button" href="decks/new?owner=@_profile.Id">+ New deck</a> }
            </div>
            <p class="muted small">Decks this player owns. Anyone can play them; each deck's record counts every game it was played in.</p>
            @if (_decks.Count == 0)
            {
                <p class="muted">No decks yet.@(_canManage ? " Build one, or import a list or a prebuilt deck." : "")</p>
            }
            else
            {
                <ul class="deck-grid">
                    @foreach (var deck in _decks)
                    {
                        var record = PlayerStats.ForDeck(deck.Id, deck.Name, _games);
                        <li class="owned-deck">
                            <a class="deck-tile" href="decks/@deck.Id">
                                <div class="art" style="@(deck.CoverImageUrl is null ? null : $"background-image:url('{deck.CoverImageUrl}')")"></div>
                                <div class="info">
                                    <strong>@deck.Name</strong>
                                    <span class="muted">@deck.GetFormat().Name · @(deck.Count(DeckSection.Main) + deck.Count(DeckSection.Commander)) cards</span>
                                    <span class="muted small">@(record.Games == 0 ? "Not played yet" : $"{record.Wins}–{record.Games - record.Wins} in {record.Games} game{(record.Games == 1 ? "" : "s")}")</span>
                                </div>
                            </a>
                            @if (_canManage && !deck.CardsInCollection && !_decksAdded.Contains(deck.Id))
                            {
                                <button class="link small" @onclick="() => AddDeckToCollectionAsync(deck)" title="Count this deck's cards as owned">+ Add its cards to the collection</button>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <div class="editor">
            <section class="profile-section">
                <div class="row spread">
                    <h2>Collection <span class="muted">(@_profile.CardCount)</span></h2>
                    @if (_canManage)
                    {
                        <div class="actions">
                            <button @onclick="() => _showScanner = true" title="Scan physical cards with the camera">📷 Scan</button>
                            <button @onclick="() => _showPaste = true">Paste list</button>
                        </div>
                    }
                </div>
                @if (_profile.Collection.Count == 0)
                {
                    <p class="muted">No cards yet.@(_canManage ? " Search, scan, or paste a list (Arena, MTGO or Moxfield format) to add the cards this player owns." : "")</p>
                }
                else
                {
                    <input type="search" placeholder="Filter the collection" @bind="_filter" @bind:event="oninput" aria-label="Filter the collection" />
                    <section class="deck-section">
                        <h3>
                            @(string.IsNullOrWhiteSpace(_filter) ? "All cards" : "Matching cards")
                            @if (worth.Usd > 0) { <span class="section-value muted">@DeckValue.FormatUsd(DeckValue.Of(FilteredCollection(), _cards).Usd)</span> }
                        </h3>
                        <ul>
                            @foreach (var line in FilteredCollection())
                            {
                                var card = CardOf(line);
                                var price = DeckValue.LinePrice(line, _cards);
                                <li class="deck-line collection-line @(card is null && !_resolving ? "unknown" : null)">
                                    <div class="qty">
                                        @if (_canManage) { <button class="icon" @onclick="() => SetQuantity(line, line.Quantity - 1)" aria-label="One fewer @line.Name">−</button> }
                                        <span>@line.Quantity</span>
                                        @if (_canManage) { <button class="icon" @onclick="() => SetQuantity(line, line.Quantity + 1)" aria-label="One more @line.Name">+</button> }
                                    </div>
                                    <button class="card-name" @onclick="() => { if (card is not null) _preview = card; }">@line.Name</button>
                                    <span class="muted small printing">@(line.SetCode?.ToUpperInvariant())@(line.CollectorNumber is null ? "" : $" #{line.CollectorNumber}")</span>
                                    <span class="price muted">@(price is { } p ? DeckValue.FormatUsd(p) : "—")</span>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </section>

            @if (_canManage)
            {
                <section class="search-side">
                    <h2>Add cards</h2>
                    @if (_changes.Count > 0)
                    {
                        var added = _changes.Where(c => c.IsAddition).Sum(c => c.Delta);
                        var removed = -_changes.Where(c => !c.IsAddition).Sum(c => c.Delta);
                        <section class="pending-changes" aria-live="polite">
                            <div class="row spread">
                                <h3>Unsaved changes</h3>
                                <div class="actions">
                                    <button @onclick="DiscardAsync" disabled="@_saving">Discard changes</button>
                                    <button class="primary" @onclick="SaveAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_profile.Name))">@(_saving ? "Saving…" : "Save")</button>
                                </div>
                            </div>
                            <p class="muted small">
                                @if (added > 0) { <span>+@added card@(added == 1 ? "" : "s")</span> }
                                @if (added > 0 && removed > 0) { <span> · </span> }
                                @if (removed > 0) { <span>−@removed card@(removed == 1 ? "" : "s")</span> }
                            </p>
                            <ul>
                                @foreach (var change in _showAllChanges ? _changes : _changes.Take(ChangesShown))
                                {
                                    <li class="@(change.IsAddition ? "added" : "removed")">
                                        <span class="delta">@(change.IsAddition ? "+" : "−")@Math.Abs(change.Delta)</span>
                                        <span class="name">@change.Name</span>
                                        <span class="muted small">@change.Printing</span>
                                    </li>
                                }
                            </ul>
                            @if (_changes.Count > ChangesShown)
                            {
                                <button class="link small" @onclick="() => _showAllChanges = !_showAllChanges">
                                    @(_showAllChanges ? "Show fewer" : $"Show all {_changes.Count}")
                                </button>
                            }
                        </section>
                    }
                    <CardSearch OnAdd="AddCard" CollectionMode="true" />
                </section>
            }
        </div>

        <section class="profile-section">
            <h2>Play history</h2>
            @if (_historyError is not null)
            {
                <ErrorMessage Message="@_historyError" />
            }
            else if (stats.Games == 0)
            {
                <p class="muted">No games yet. Pick @_profile.Name as a player when setting up a game, and it's recorded here when the game ends.</p>
            }
            else
            {
                <table class="deck-records">
                    <thead><tr><th>Deck played</th><th>Games</th><th>Wins</th><th>Win rate</th></tr></thead>
                    <tbody>
                        @foreach (var deck in stats.Decks)
                        {
                            <tr>
                                <td>@deck.DeckName</td>
                                <td>@deck.Games</td>
                                <td>@deck.Wins</td>
                                <td>@(((double)deck.Wins / deck.Games).ToString("P0"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <GameHistoryList Games="MyGames().Take(_shown).ToList()" ProfileId="_profile.Id" />
                @if (MyGames().Count() > _shown)
                {
                    <button @onclick="() => _shown += 25">Show more</button>
                }
            }
        </section>

        @if (_showPaste)
        {
            <div class="overlay" @onclick="() => _showPaste = false">
                <div class="dialog" @onclick:stopPropagation="true" role="dialog" aria-label="Paste a card list">
                    <h2>Paste a card list</h2>
                    <p class="muted small">One card per line, like <code>4 Lightning Bolt (2X2) 117</code>. Set and number are optional but give the right price.</p>
                    <textarea rows="12" @bind="_pasteText" placeholder="1 Sol Ring (C21) 263"></textarea>
                    @if (_pasteProblems.Count > 0)
                    {
                        <ul class="small error-text">
                            @foreach (var problem in _pasteProblems) { <li>@problem</li> }
                        </ul>
                    }
                    <div class="actions">
                        <button class="primary" @onclick="AddPastedAsync" disabled="@string.IsNullOrWhiteSpace(_pasteText)">Add to collection</button>
                        <button @onclick="() => _showPaste = false">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @if (_showScanner)
        {
            <CardScanner OnAdd="AddCard" OnClose="() => _showScanner = false" CollectionMode="true" />
        }

        <CardPreview Card="_preview" OnClose="() => _preview = null" />
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private PlayerProfile? _profile;
    private string _savedName = "";
    private List<Deck> _decks = [];
    private List<GameRecord> _games = [];
    private Dictionary<Guid, CardInfo> _cards = [];
    private DeckValue? _decksWorth;
    private CardInfo? _preview;
    private string _filter = "";
    private string _pasteText = "";
    private IReadOnlyList<string> _pasteProblems = [];
    private int _shown = 25;
    private bool _dirty;
    private bool _saving;
    private bool _resolving;
    private bool _showPaste;
    private bool _showScanner;
    private string? _loadError;
    private string? _historyError;
    private string? _error;
    private IDisposable? _leaveGuard;
    private bool _canManage;
    private string? _claimCode;
    private string? _codeError;
    private bool _codeBusy;
    private bool _copied;

    /// <summary>The profile as last loaded or saved, and the collection changes since.</summary>
    private CollectionSnapshot? _saved;
    private IReadOnlyList<CollectionChange> _changes = [];
    private bool _showAllChanges;

    /// <summary>Decks whose cards were added to the collection since it was saved. Marked on the deck when it's saved.</summary>
    private readonly HashSet<Guid> _decksAdded = [];

    /// <summary>How many changes the panel lists before "Show all", so a pasted list doesn't fill the page.</summary>
    private const int ChangesShown = 10;

    private void SnapshotSaved()
    {
        _saved = CollectionSnapshot.Of(_profile!);
        _changes = [];
        _showAllChanges = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await Library.InitializeAsync();
        if (Library.Profiles is not { } profiles) return;

        try
        {
            _profile = await profiles.GetAsync(Id);
            if (_profile is null) { _loadError = "That player doesn't exist any more, or isn't in this playgroup."; return; }
            _savedName = _profile.Name;
            SnapshotSaved();
            _canManage = Library.CanManage(_profile);
            if (Library.Store is { } decks)
                _decks = (await decks.ListAsync()).Where(d => d.OwnerProfileId == Id).ToList();
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException)
        {
            _loadError = CloudErrors.Describe("Couldn't load the player", e);
            return;
        }

        try
        {
            if (Library.History is { } history) _games = (await history.ListAsync()).ToList();
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException)
        {
            _historyError = CloudErrors.Describe("Couldn't load play history", e);
        }

        _leaveGuard = Nav.RegisterLocationChangingHandler(async ctx =>
        {
            if (_dirty && !await Js.InvokeAsync<bool>("confirm", "Leave without saving your changes?")) ctx.PreventNavigation();
        });

        await ResolveCollectionAsync();
        await ResolveDecksAsync();
    }

    private IEnumerable<GameRecord> MyGames() => _games.Where(g => g.PlayerFor(Id) is not null);

    private IEnumerable<DeckCard> FilteredCollection()
    {
        var words = _filter.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return _profile!.Collection
            .Where(l => words.All(w => l.Name.Contains(w, StringComparison.OrdinalIgnoreCase)
                || (CardOf(l)?.TypeLine?.Contains(w, StringComparison.OrdinalIgnoreCase) ?? false)
                || string.Equals(l.SetCode, w, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(l => l.Name, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(l => l.SetCode);
    }

    private CardInfo? CardOf(DeckCard line) => line.ScryfallId is { } id && _cards.TryGetValue(id, out var c) ? c : null;

    private static string WorthTitle(DeckValue worth) =>
        "Market value of the collection from Scryfall"
        + (worth.UnpricedCards > 0 ? $". {worth.UnpricedCards} card(s) have no price and aren't counted." : ".");

    private async Task ResolveCollectionAsync()
    {
        if (_profile is null) return;
        _resolving = true;
        StateHasChanged();
        try
        {
            var result = await Catalog.ResolveAsync(_profile.Collection);
            foreach (var (id, card) in result.Cards) _cards[id] = card;
        }
        catch (Exception e) when (e is ScryfallException or HttpRequestException)
        {
            _error = "Couldn't reach Scryfall to price the cards. The value may be incomplete.";
        }
        finally
        {
            _resolving = false;
        }
    }

    private async Task ResolveDecksAsync()
    {
        var cards = new Dictionary<Guid, CardInfo>();
        try
        {
            foreach (var deck in _decks)
                foreach (var (id, card) in (await Catalog.ResolveAsync(deck)).Cards) cards[id] = card;
        }
        catch (Exception e) when (e is ScryfallException or HttpRequestException) { }
        _decksWorth = DeckValue.Of(_decks.SelectMany(d => d.Cards), cards);
        StateHasChanged();
    }

    private void Touch()
    {
        _dirty = true;
        if (_saved is not null) _changes = _saved.ChangesIn(_profile!);
    }

    /// <summary>Puts the collection and name back as they were last loaded or saved, after asking.</summary>
    private async Task DiscardAsync()
    {
        if (_profile is null || _saved is null) return;
        if (!await Js.InvokeAsync<bool>("confirm", "Discard your unsaved changes to this player?")) return;
        _saved.Restore(_profile);
        _decksAdded.Clear();
        _dirty = false;
        _error = null;
        SnapshotSaved();
    }

    private void SetQuantity(DeckCard line, int quantity)
    {
        _profile!.SetQuantity(line, quantity);
        Touch();
    }

    private void AddCard((CardInfo Card, DeckSection Section) add)
    {
        _cards[add.Card.Id] = add.Card;
        _profile!.AddToCollection(add.Card);
        Touch();
    }

    private async Task AddDeckToCollectionAsync(Deck deck)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Add all {deck.Cards.Sum(c => c.Quantity)} cards in \"{deck.Name}\" to {_profile!.Name}'s collection?")) return;
        _profile.AddDeckToCollection(deck);
        _decksAdded.Add(deck.Id);
        Touch();
        await ResolveCollectionAsync();
    }

    private async Task AddPastedAsync()
    {
        var parsed = DeckListText.Parse(_pasteText);
        _pasteProblems = parsed.Problems;
        if (parsed.Cards.Count == 0)
        {
            if (_pasteProblems.Count == 0) _pasteProblems = ["No cards found in the list."];
            return;
        }
        foreach (var line in parsed.Cards) _profile!.AddToCollection(line);
        Touch();
        if (_pasteProblems.Count == 0)
        {
            _showPaste = false;
            _pasteText = "";
        }
        else
        {
            _pasteText = ""; // the readable lines were added; the problems stay on screen
        }
        await ResolveCollectionAsync();
    }

    private async Task SaveAsync()
    {
        if (_profile is null || Library.Profiles is not { } store) return;
        _saving = true;
        _error = null;
        try
        {
            var saved = await store.SaveAsync(_profile);
            _dirty = false;
            _savedName = saved.Name;
            SnapshotSaved();
            await Library.MyProfileSavedAsync(saved);
            await MarkDecksAddedAsync();
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException)
        {
            _error = CloudErrors.Describe("Couldn't save", e);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Records on each deck added to the collection that its cards are in it, so it can't be added again.</summary>
    private async Task MarkDecksAddedAsync()
    {
        if (Library.Store is not { } decks) return;
        foreach (var deck in _decks.Where(d => _decksAdded.Contains(d.Id)).ToList())
        {
            await decks.SetCardsInCollectionAsync(deck.Id, true);
            deck.CardsInCollection = true;
            _decksAdded.Remove(deck.Id);
        }
    }

    private async Task DeleteAsync()
    {
        if (_profile is null || Library.Profiles is not { } store) return;
        var mine = _profile.UserId == Library.UserId;
        var message = mine
            ? "Delete your profile? Your collection and decks are deleted, and you leave every playgroup. Past games keep your name. This can't be undone."
            : $"Delete {_savedName}? Their collection and decks are deleted, and they leave every playgroup. Past games keep their name. This can't be undone.";
        if (!await Js.InvokeAsync<bool>("confirm", message)) return;
        try
        {
            await store.DeleteAsync(_profile.Id);
            _dirty = false;
            if (mine) await Library.RetryAccountAsync(); // back to choosing a profile
            Nav.NavigateTo("profiles");
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException)
        {
            _error = CloudErrors.Describe("Couldn't delete", e);
        }
    }

    private async Task LoadClaimCodeAsync(bool reset)
    {
        if (_profile is null) return;
        _codeBusy = true;
        _codeError = null;
        try
        {
            _claimCode = await Library.GetClaimCodeAsync(_profile.Id, reset);
            _copied = false;
        }
        catch (DeckLibraryException e)
        {
            _codeError = e.Message;
        }
        finally
        {
            _codeBusy = false;
        }
    }

    private async Task ResetClaimCodeAsync()
    {
        if (await Js.InvokeAsync<bool>("confirm", "Make a new invite code? The old one stops working.")) await LoadClaimCodeAsync(true);
    }

    private async Task CopyClaimCodeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _claimCode);
            _copied = true;
        }
        catch (JSException) { }
    }

    public void Dispose() => _leaveGuard?.Dispose();
}
