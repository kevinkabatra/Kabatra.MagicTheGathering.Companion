@page "/profiles"
@implements IDisposable
@inject DeckLibrary Library
@inject PlayHistory Recorder
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Players · MTG Companion</PageTitle>

<div class="page">
    <header class="page-head">
        <a href="" class="back">← Game</a>
        <h1>Players</h1>
    </header>

    <AccountPanel />

    @if (Library.Profiles is not null)
    {
        var admin = Library.IsAdmin(Library.CurrentGroup);
        @if (admin || Library.CurrentGroup is null)
        {
            <form class="inline-form" @onsubmit="CreateAsync">
                <input placeholder="New player's name" maxlength="60" @bind="_newName" aria-label="New player's name" />
                <button class="primary" type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))">+ New player</button>
            </form>
            <p class="muted small">For friends without an account. You look after their profile until they sign in and claim it with its invite code.</p>
            @if (admin)
            {
                <form class="inline-form" @onsubmit="AddByCodeAsync">
                    <input placeholder="Someone's player code" maxlength="20" @bind="_playerCode" aria-label="Player code" style="text-transform:uppercase" />
                    <button type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_playerCode))">Add by player code</button>
                </form>
            }
        }
        else
        {
            <p class="muted small">Only the playgroup's admin can add or remove players.</p>
        }
        <ErrorMessage Message="@_error" />

        @if (_loading)
        {
            <p class="muted">Loading players…</p>
        }
        else if (_profiles.Count == 0)
        {
            <p class="muted center">
                No players yet. Add everyone in your playgroup to track the cards they own, the decks they built and how their games went.
            </p>
        }
        else
        {
            <ul class="profile-grid">
                @foreach (var profile in _profiles)
                {
                    var stats = PlayerStats.For(profile.Id, _games);
                    var decks = _decks.Count(d => d.OwnerProfileId == profile.Id);
                    <li>
                        <a class="profile-tile" href="profiles/@profile.Id">
                            <span class="avatar" aria-hidden="true">@Initial(profile.Name)</span>
                            <span class="info">
                                <strong>@profile.Name</strong>
                                <span class="muted small">
                                    @Plural(stats.Games, "game") · @Plural(stats.Wins, "win")@(stats.WinRate is { } rate ? $" ({rate:P0})" : "")
                                </span>
                                <span class="muted small">@Plural(decks, "deck") · @Plural(profile.CardCount, "card") owned</span>
                                @if (profile.Id == Library.CurrentGroup?.AdminProfileId) { <span class="badge">Admin</span> }
                                else if (!profile.IsClaimed) { <span class="badge">Not signed in yet</span> }
                            </span>
                        </a>
                        @if (admin && profile.Id != Library.CurrentGroup?.AdminProfileId)
                        {
                            <button class="link small" @onclick="() => RemoveAsync(profile)">Remove from group</button>
                        }
                    </li>
                }
            </ul>
        }

        <section class="history">
            <h2>Recent games</h2>
            @if (_pending > 0)
            {
                <p class="notice">@Plural(_pending, "game") finished on this device @(_pending == 1 ? "hasn't" : "haven't") been saved to @(Library.CurrentGroup?.Name ?? "the playgroup") yet. They'll be sent when you're back online.</p>
            }
            @if (_historyError is not null)
            {
                <ErrorMessage Message="@_historyError" />
            }
            else if (!_loading && _games.Count == 0)
            {
                <p class="muted">No games yet. Games are saved here when you start a new game after finishing one.</p>
            }
            <GameHistoryList Games="_games.Take(_shown).ToList()" OnDelete="DeleteGameAsync" />
            @if (_games.Count > _shown)
            {
                <button @onclick="() => _shown += 25">Show more</button>
            }
        </section>
    }
</div>

@code {
    private List<PlayerProfile> _profiles = [];
    private List<Deck> _decks = [];
    private List<GameRecord> _games = [];
    private string _newName = "";
    private string _playerCode = "";
    private bool _loading = true;
    private bool _busy;
    private int _pending;
    private int _shown = 25;
    private string? _error;
    private string? _historyError;
    private string? _loadedKey;
    private string StoreKey => $"{Library.SignedIn}:{Library.MyProfile?.Id}:{Library.CurrentGroup?.Id}";

    protected override async Task OnInitializedAsync()
    {
        Library.Changed += OnLibraryChanged;
        await Library.InitializeAsync();
        await LoadAsync();
    }

    private void OnLibraryChanged() => InvokeAsync(async () =>
    {
        if (StoreKey != _loadedKey) await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _loadedKey = StoreKey;
        _loading = true;
        _error = _historyError = null;
        try
        {
            if (Library.Profiles is not { } profiles) { _profiles = []; return; }
            _profiles = (await profiles.ListAsync()).ToList();
            if (Library.Store is { } decks) _decks = (await decks.ListAsync()).ToList();
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException)
        {
            _error = CloudErrors.Describe("Couldn't load players", e);
        }
        finally
        {
            _loading = false;
        }

        // History is loaded separately so a problem with it doesn't hide the players.
        await Recorder.TrySyncAsync();
        _pending = await Recorder.PendingAsync();
        try
        {
            _games = Library.History is { } history ? (await history.ListAsync()).ToList() : [];
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException)
        {
            _historyError = CloudErrors.Describe("Couldn't load play history", e);
        }
    }

    private async Task CreateAsync()
    {
        if (Library.Profiles is not { } store || string.IsNullOrWhiteSpace(_newName)) return;
        var name = _newName.Trim();
        if (_profiles.Any(p => string.Equals(p.Name, name, StringComparison.CurrentCultureIgnoreCase)))
        {
            _error = $"There's already a player called {name}.";
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            var saved = await store.CreateAsync(name);
            Nav.NavigateTo($"profiles/{saved.Id}");
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException)
        {
            _error = CloudErrors.Describe("Couldn't add the player", e);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddByCodeAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Library.AddPlayerByCodeAsync(_playerCode);
            _playerCode = "";
            await LoadAsync();
        }
        catch (DeckLibraryException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(PlayerProfile profile)
    {
        if (!await Js.InvokeAsync<bool>("confirm",
                $"Remove {profile.Name} from {Library.CurrentGroup?.Name}? Their profile, collection and decks stay; they just leave this group."))
            return;
        _error = null;
        try
        {
            await Library.RemovePlayerAsync(profile.Id);
            _profiles.Remove(profile);
        }
        catch (DeckLibraryException e)
        {
            _error = e.Message;
        }
    }

    private async Task DeleteGameAsync(GameRecord game)
    {
        if (Library.History is not { } history) return;
        if (!await Js.InvokeAsync<bool>("confirm", "Remove this game from play history? This can't be undone.")) return;
        try
        {
            await history.DeleteAsync(game.Id);
            _games.Remove(game);
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException)
        {
            _historyError = CloudErrors.Describe("Couldn't remove the game", e);
        }
    }

    private static string Initial(string name) => name.Trim() is { Length: > 0 } n ? char.ToUpperInvariant(n[0]).ToString() : "?";

    private static string Plural(int count, string noun) => $"{count} {noun}{(count == 1 ? "" : "s")}";

    public void Dispose() => Library.Changed -= OnLibraryChanged;
}
