@page "/decks/import"
@inject DeckLibrary Library
@inject CardCatalog Catalog
@inject PreconCatalog Precons
@inject NavigationManager Nav

<PageTitle>Import deck · MTG Companion</PageTitle>

<div class="page">
    <header class="page-head">
        <a href="decks" class="back">← Decks</a>
        <h1>Import a deck</h1>
    </header>

    @if (Library.Store is null)
    {
        <AccountPanel />
    }
    else
    {
        <div class="mode-tabs" role="tablist">
            <button role="tab" aria-selected="@(!_preconMode)" class="@(_preconMode ? "" : "on")" @onclick="() => SetMode(false)">Paste a list</button>
            <button role="tab" aria-selected="@_preconMode" class="@(_preconMode ? "on" : "")" @onclick="() => SetMode(true)">Prebuilt deck</button>
        </div>

        <section class="setup-like">
            @if (_preconMode)
            {
                <p class="muted">
                    Pick an official prebuilt deck. Deck lists come from <a href="https://mtgjson.com" target="_blank" rel="noopener">MTGJSON</a>
                    and use the exact printings from the box.
                </p>

                @if (_precons is null)
                {
                    <p class="muted">@(_error is null ? "Loading prebuilt decks…" : "")</p>
                }
                else if (_chosen is null)
                {
                    <div class="field-row">
                        <label class="field grow">
                            <span>Search</span>
                            <input type="search" @bind="_query" @bind:event="oninput" placeholder="Deck name or set code" aria-label="Search prebuilt decks" />
                        </label>
                        <label class="field">
                            <span>Type</span>
                            <select @bind="_type">
                                <option value="">All types</option>
                                @foreach (var t in _types) { <option value="@t">@t</option> }
                            </select>
                        </label>
                    </div>

                    var matches = Filtered().ToList();
                    <ul class="precon-list">
                        @foreach (var p in matches.Take(MaxShown))
                        {
                            <li>
                                <button @onclick="() => Choose(p)">
                                    <strong>@p.Name</strong>
                                    <span class="muted">@p.SetCode.ToUpperInvariant() · @p.Type@(p.ReleaseDate is { } d ? $" · {d.Year}" : "")</span>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (matches.Count == 0)
                    {
                        <p class="muted">No prebuilt decks match.</p>
                    }
                    else if (matches.Count > MaxShown)
                    {
                        <p class="muted">Showing @MaxShown of @matches.Count. Search to narrow it down.</p>
                    }
                }
                else
                {
                    <div class="precon-chosen">
                        <div>
                            <strong>@_chosen.Name</strong>
                            <span class="muted">@_chosen.SetCode.ToUpperInvariant() · @_chosen.Type@(_chosen.ReleaseDate is { } d ? $" · {d:MMM yyyy}" : "")</span>
                        </div>
                        <button class="link" @onclick="() => _chosen = null" disabled="@_busy">Choose another</button>
                    </div>
                }
            }
            else
            {
                <p class="muted">
                    Paste a list exported from MTG Arena, MTGO, Moxfield, Archidekt or similar, one card per line,
                    like <code>4 Lightning Bolt</code> or <code>1 Sol Ring (C21) 263</code>.
                </p>
                <textarea rows="14" @bind="_text" @bind:event="oninput" @bind:after="() => _confirmedProblems = false" placeholder="@Example" aria-label="Deck list"></textarea>
            }

            @if (!_preconMode || _chosen is not null)
            {
                <div class="field-row">
                    <label class="field grow">
                        <span>Deck name</span>
                        <input @bind="_name" placeholder="Taken from the list if it has one" maxlength="120" />
                    </label>
                    @if (_owners.Count > 1)
                    {
                        <label class="field grow">
                            <span>Owner</span>
                            <select @bind="_ownerId">
                                @foreach (var p in _owners) { <option value="@p.Id">@p.Name</option> }
                            </select>
                        </label>
                    }
                    <label class="field grow">
                        <span>Format</span>
                        <select @bind="_format">
                            @foreach (var f in DeckFormat.All) { <option value="@f.Id">@f.Name</option> }
                        </select>
                    </label>
                </div>
            }

            @if (_problems.Count > 0)
            {
                <div class="legality bad">
                    <strong>Some lines couldn't be read and will be skipped:</strong>
                    <ul>@foreach (var p in _problems) { <li>@p</li> }</ul>
                </div>
            }

            <ErrorMessage Message="@_error" />
            @if (!_preconMode || _chosen is not null)
            {
                <button class="primary big" @onclick="ImportAsync" disabled="@(_busy || !CanImport)">
                    @(_busy ? _status : !_preconMode && _problems.Count > 0 ? "Import anyway" : "Import")
                </button>
            }
        </section>
    }
</div>

@code {
    private const string Example = "Commander\n1 Krenko, Mob Boss\n\nDeck\n1 Sol Ring\n30 Mountain";
    private const int MaxShown = 50;
    private string _text = "";
    private string _name = "";
    private string _ownerId = "";
    private List<PlayerProfile> _owners = [];
    private string _format = DeckFormat.Commander.Id;
    private List<string> _problems = [];
    private bool _confirmedProblems;
    private bool _busy;
    private string _status = "";
    private string? _error;

    private bool _preconMode;
    private IReadOnlyList<PreconSummary>? _precons;
    private List<string> _types = [];
    private string _query = "";
    private string _type = "Commander Deck";
    private PreconSummary? _chosen;

    private bool CanImport => _preconMode ? _chosen is not null : !string.IsNullOrWhiteSpace(_text);

    protected override async Task OnInitializedAsync()
    {
        await Library.InitializeAsync();
        // You own what you import, or you can give it to an unclaimed profile you look after.
        if (Library.MyProfile is { } me) { _owners = [me]; _ownerId = me.Id.ToString(); }
        try
        {
            if (Library.Profiles is { } profiles)
                _owners.AddRange((await profiles.ListAsync()).Where(p => Library.CanManage(p) && p.Id != Library.MyProfile?.Id));
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException) { } // you can still own it yourself
    }

    private async Task SetMode(bool precon)
    {
        _preconMode = precon;
        _problems = [];
        _error = null;
        if (precon && _precons is null) await LoadPreconsAsync();
    }

    private async Task LoadPreconsAsync()
    {
        try
        {
            _precons = await Precons.ListAsync();
            var present = _precons.Select(p => p.Type).Where(t => t.Length > 0).ToHashSet();
            _types = PreconCatalog.CommonTypes.Where(present.Contains)
                .Concat(present.Except(PreconCatalog.CommonTypes).Order(StringComparer.OrdinalIgnoreCase))
                .ToList();
            if (!present.Contains(_type)) _type = "";
        }
        catch (Exception e) when (e is PreconException or HttpRequestException or System.Text.Json.JsonException)
        {
            _error = $"Couldn't load prebuilt decks: {e.Message}";
        }
    }

    private IEnumerable<PreconSummary> Filtered()
    {
        var words = _query.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return (_precons ?? []).Where(p =>
            (_type.Length == 0 || p.Type == _type)
            && words.All(w => p.Name.Contains(w, StringComparison.OrdinalIgnoreCase) || p.SetCode.Equals(w, StringComparison.OrdinalIgnoreCase)));
    }

    private void Choose(PreconSummary precon)
    {
        _chosen = precon;
        _name = precon.Name;
        _format = PreconCatalog.FormatFor(precon.Type, hasCommander: precon.Type.Contains("Commander", StringComparison.OrdinalIgnoreCase)).Id;
        _problems = [];
        _error = null;
    }

    private async Task ImportAsync()
    {
        if (Library.Store is null) return;
        _error = null;
        if (_preconMode) await ImportPreconAsync();
        else await ImportListAsync();
    }

    private async Task ImportListAsync()
    {
        var parsed = DeckListText.Parse(_text);
        if (parsed.Cards.Count == 0)
        {
            _error = "No cards found in that list.";
            return;
        }
        _problems = parsed.Problems.ToList();
        if (_problems.Count > 0 && !_confirmedProblems)
        {
            _confirmedProblems = true; // the next click imports anyway
            return;
        }

        var deck = new Deck
        {
            Name = !string.IsNullOrWhiteSpace(_name) ? _name.Trim() : parsed.Name ?? "Imported deck",
            Format = GuessFormat(parsed.Cards),
            Cards = parsed.Cards.ToList(),
        };
        await ResolveAndSaveAsync(deck);
    }

    private async Task ImportPreconAsync()
    {
        if (_chosen is not { } precon) return;
        _busy = true;
        try
        {
            _status = "Fetching the deck list…";
            StateHasChanged();
            var deck = await Precons.GetDeckAsync(precon);
            if (!string.IsNullOrWhiteSpace(_name)) deck.Name = _name.Trim();
            deck.Format = GuessFormat(deck.Cards);
            await ResolveAndSaveAsync(deck);
        }
        catch (Exception e) when (e is PreconException or HttpRequestException or System.Text.Json.JsonException)
        {
            _error = $"Import failed: {e.Message}";
            _busy = false;
        }
    }

    private async Task ResolveAndSaveAsync(Deck deck)
    {
        if (Library.Store is not { } store) return;
        deck.OwnerProfileId = Guid.TryParse(_ownerId, out var owner) ? owner : Library.MyProfile?.Id;
        _busy = true;
        try
        {
            _status = $"Looking up {deck.Cards.Count} cards…";
            StateHasChanged();
            var resolved = await Catalog.ResolveAsync(deck);
            deck.CoverImageUrl = deck.Commanders
                .Select(c => c.ScryfallId is { } id && resolved.Cards.TryGetValue(id, out var card) ? card.ArtCrop : null)
                .FirstOrDefault(url => url is not null);

            _status = "Saving…";
            StateHasChanged();
            var saved = await store.SaveAsync(deck);
            Nav.NavigateTo($"decks/{saved.Id}");
        }
        catch (Exception e) when (e is ScryfallException or SupabaseException or HttpRequestException)
        {
            _error = $"Import failed: {e.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A list with a commander section can't be a 60-card constructed deck, so don't leave it as one.</summary>
    private string GuessFormat(IReadOnlyList<DeckCard> cards)
    {
        var chosen = DeckFormat.FromId(_format);
        if (cards.Any(c => c.Section == DeckSection.Commander) && !chosen.HasCommander) return DeckFormat.Commander.Id;
        return chosen.Id;
    }
}
