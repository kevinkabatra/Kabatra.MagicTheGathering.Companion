@inject GameSession Session
@inject DeckLibrary Library

<section class="setup">
    <div class="row spread">
        <h1>New game</h1>
        <div class="actions">
            <a href="profiles" class="button">Players →</a>
            <a href="decks" class="button">Decks →</a>
            @if (Library.Guest && Library.Configured)
            {
                <a href="sign-in" class="button">Sign in</a>
            }
        </div>
    </div>

    @if (Library.SignedIn && Library.Groups.Count > 0)
    {
        @* The game's players, decks and play history all come from this group. *@
        <label class="field">
            <span>Playgroup</span>
            <select value="@Library.CurrentGroup?.Id" @onchange="SelectGroupAsync" disabled="@_switchingGroup">
                @foreach (var group in Library.Groups)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>
        </label>
    }

    <label class="field">
        <span>Format</span>
        <select @bind="_formatIndex">
            @for (var i = 0; i < GameFormat.Presets.Count; i++)
            {
                var f = GameFormat.Presets[i];
                <option value="@i">@f.Name (@f.StartingLife life)</option>
            }
            <option value="@CustomIndex">Custom…</option>
        </select>
    </label>

    @if (_formatIndex == CustomIndex)
    {
        <div class="field-row">
            <label class="field">
                <span>Starting life</span>
                <input type="number" min="1" max="999" @bind="_customLife" />
            </label>
            <label class="check">
                <input type="checkbox" @bind="_customCommander" />
                <span>Track commander damage</span>
            </label>
        </div>
    }

    <div class="field">
        <span>Players</span>
        <div class="stepper">
            <button type="button" @onclick="() => SetCount(_names.Count - 1)" disabled="@(_names.Count <= Game.MinPlayers)" aria-label="Fewer players">−</button>
            <strong>@_names.Count</strong>
            <button type="button" @onclick="() => SetCount(_names.Count + 1)" disabled="@(_names.Count >= Game.MaxPlayers)" aria-label="More players">+</button>
        </div>
    </div>

    <ol class="player-names">
        @for (var i = 0; i < _names.Count; i++)
        {
            var index = i;
            <li>
                <span class="swatch" style="background:@Game.DefaultColors[index % Game.DefaultColors.Count]"></span>
                <div class="seat">
                    @if (_profiles.Count > 0)
                    {
                        <select value="@(_profileIds[index]?.ToString() ?? "")" @onchange="e => PickProfile(index, e.Value?.ToString())" aria-label="Player @(index + 1) profile">
                            <option value="">Guest</option>
                            @foreach (var profile in _profiles)
                            {
                                <option value="@profile.Id" disabled="@(_profileIds.Contains(profile.Id) && _profileIds[index] != profile.Id)">@profile.Name</option>
                            }
                        </select>
                    }
                    <input placeholder="Player @(index + 1)" value="@_names[index]"
                           @onchange="e => _names[index] = e.Value?.ToString() ?? string.Empty" aria-label="Player @(index + 1) name" />
                    @if (_decks.Count > 0)
                    {
                        <div class="seat-deck">
                        <select value="@(_deckIds[index]?.ToString() ?? "")" @onchange="e => PickDeck(index, e.Value?.ToString())" aria-label="Player @(index + 1) deck">
                            <option value="">No deck</option>
                            @* Any deck can be played by anyone; the seat's own decks are listed first. *@
                            @foreach (var owner in DecksFor(_profileIds[index]))
                            {
                                <optgroup label="@owner.Key">
                                    @foreach (var deck in owner)
                                    {
                                        <option value="@deck.Id">@deck.Name (@DeckDetails(deck))</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        @if (_decks.FirstOrDefault(d => d.Id == _deckIds[index]) is { } picked)
                        {
                            <BracketBadge Deck="picked" />
                        }
                        </div>
                    }
                </div>
                <label class="radio" title="Goes first">
                    <input type="radio" name="first" checked="@(_firstPlayer == index)" @onchange="() => _firstPlayer = index" />
                    <span>first</span>
                </label>
            </li>
        }
    </ol>

    @if (string.Join(" ", new[] { _formatHint, BracketHint() }.OfType<string>()) is { Length: > 0 } hint)
    {
        <p class="muted small">@hint</p>
    }

    <label class="radio">
        <input type="radio" name="first" checked="@(_firstPlayer == RandomFirst)" @onchange="() => _firstPlayer = RandomFirst" />
        <span>Pick who goes first at random</span>
    </label>

    <button class="primary big" @onclick="StartAsync">Start game</button>
</section>

@code {
    private const int RandomFirst = -1;
    private static readonly int CustomIndex = GameFormat.Presets.Count;

    private int _formatIndex = GameFormat.Presets.ToList().IndexOf(GameFormat.Commander);
    private int _customLife = 20;
    private bool _customCommander;
    private int _firstPlayer = RandomFirst;
    private List<string> _names = ["", "", "", ""];
    private List<Guid?> _deckIds = [null, null, null, null];
    private List<Guid?> _profileIds = [null, null, null, null];
    private List<Deck> _decks = [];
    private List<PlayerProfile> _profiles = [];
    private string? _formatHint;
    private bool _switchingGroup;

    protected override async Task OnInitializedAsync()
    {
        var last = (await Session.GetLastPlayersAsync()).Take(Game.MaxPlayers).ToList();
        if (last.Count >= Game.MinPlayers)
        {
            _names = last.Select(p => p.Name).ToList();
            _profileIds = last.Select(p => p.ProfileId).ToList();
            _deckIds = _names.Select(_ => (Guid?)null).ToList();
        }

        await Library.InitializeAsync();
        await LoadDecksAndProfilesAsync();
    }

    /// <summary>Loads the current playgroup's decks and players, and drops seat picks that aren't in it.</summary>
    private async Task LoadDecksAndProfilesAsync()
    {
        _decks = [];
        _profiles = [];
        // Decks and profiles are optional: if they can't be loaded (offline, not signed in), setup works as before.
        try
        {
            if (Library.Store is { } store)
                _decks = (await store.ListAsync())
                    .OrderBy(d => d.OwnerName, StringComparer.CurrentCultureIgnoreCase)
                    .ThenBy(d => d.Name, StringComparer.CurrentCultureIgnoreCase)
                    .ToList();
            if (Library.Profiles is { } profiles)
                _profiles = (await profiles.ListAsync()).ToList();
        }
        catch (Exception e) when (e is SupabaseException or HttpRequestException) { }

        // Forget remembered profiles that were deleted, or that belong to another playgroup.
        for (var i = 0; i < _profileIds.Count; i++)
            if (_profileIds[i] is { } id && _profiles.All(p => p.Id != id)) _profileIds[i] = null;
        for (var i = 0; i < _deckIds.Count; i++)
            if (_deckIds[i] is { } id && _decks.All(d => d.Id != id)) _deckIds[i] = null;
    }

    private async Task SelectGroupAsync(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var groupId) || groupId == Library.CurrentGroup?.Id) return;
        _switchingGroup = true;
        try
        {
            await Library.SelectGroupAsync(groupId);
            await LoadDecksAndProfilesAsync();
            UpdateFormatFromDecks();
        }
        finally { _switchingGroup = false; }
    }

    /// <summary>"Commander · Bracket 3", or just the format for decks that brackets don't apply to.</summary>
    private static string DeckDetails(Deck deck) =>
        CommanderBrackets.Assess(deck) is { } bracket
            ? $"{deck.GetFormat().Name} · Bracket {bracket.Number}"
            : deck.GetFormat().Name;

    /// <summary>A note when the chosen Commander decks aren't all in the same bracket.</summary>
    private string? BracketHint()
    {
        var brackets = _deckIds.OfType<Guid>()
            .Select(id => _decks.FirstOrDefault(d => d.Id == id))
            .OfType<Deck>()
            .Select(CommanderBrackets.Assess)
            .OfType<BracketAssessment>()
            .Select(a => a.Number)
            .Distinct()
            .Order()
            .ToList();
        return brackets.Count > 1
            ? $"The chosen decks range from Bracket {brackets[0]} to Bracket {brackets[^1]}. Check the table is happy with that."
            : null;
    }

    /// <summary>Decks grouped by owner, with the seat's own decks first.</summary>
    private IEnumerable<IGrouping<string, Deck>> DecksFor(Guid? profileId) =>
        _decks
            .GroupBy(d => string.IsNullOrWhiteSpace(d.OwnerName) ? "Unassigned" : d.OwnerName)
            .OrderBy(g => profileId is not null && g.Any(d => d.OwnerProfileId == profileId) ? 0 : 1);

    private void PickProfile(int index, string? value)
    {
        var previous = _profiles.FirstOrDefault(p => p.Id == _profileIds[index]);
        _profileIds[index] = Guid.TryParse(value, out var id) ? id : null;
        var profile = _profiles.FirstOrDefault(p => p.Id == id);
        if (profile is not null)
        {
            _names[index] = profile.Name;
        }
        else if (previous is not null && _names[index] == previous.Name)
        {
            _names[index] = ""; // back to a guest: don't keep the profile's name
        }
    }

    private void SetCount(int count)
    {
        count = Math.Clamp(count, Game.MinPlayers, Game.MaxPlayers);
        while (_names.Count < count) { _names.Add(""); _deckIds.Add(null); _profileIds.Add(null); }
        while (_names.Count > count) { _names.RemoveAt(_names.Count - 1); _deckIds.RemoveAt(_deckIds.Count - 1); _profileIds.RemoveAt(_profileIds.Count - 1); }
        if (_firstPlayer >= count) _firstPlayer = RandomFirst;
        UpdateFormatFromDecks();
    }

    private void PickDeck(int index, string? value)
    {
        _deckIds[index] = Guid.TryParse(value, out var id) ? id : null;
        var deck = _decks.FirstOrDefault(d => d.Id == id);
        // A blank seat picking a deck is most likely its owner: fill in their profile (or name).
        if (deck is not null && string.IsNullOrWhiteSpace(_names[index]) && _profileIds[index] is null)
        {
            if (_profiles.FirstOrDefault(p => p.Id == deck.OwnerProfileId) is { } owner && !_profileIds.Contains(owner.Id))
                PickProfile(index, owner.Id.ToString());
            else if (!string.IsNullOrWhiteSpace(deck.OwnerName))
                _names[index] = deck.OwnerName;
        }
        UpdateFormatFromDecks();
    }

    /// <summary>When everyone's chosen deck is for the same format, switch the game to it.</summary>
    private void UpdateFormatFromDecks()
    {
        var formats = _deckIds.OfType<Guid>()
            .Select(id => _decks.FirstOrDefault(d => d.Id == id)?.GetFormat())
            .OfType<DeckFormat>()
            .Where(f => f.ScryfallKey is not null) // casual decks don't imply a format
            .Select(f => f.GameFormat)
            .Distinct()
            .ToList();

        _formatHint = null;
        if (formats.Count == 1)
        {
            _formatIndex = GameFormat.Presets.ToList().IndexOf(formats[0]);
            _formatHint = $"Format set to {formats[0].Name} to match the decks.";
        }
        else if (formats.Count > 1)
        {
            _formatHint = "The chosen decks are for different formats.";
        }
    }

    private async Task StartAsync()
    {
        var format = _formatIndex == CustomIndex
            ? GameFormat.Custom(Math.Clamp(_customLife, 1, 999), _customCommander)
            : GameFormat.Presets[_formatIndex];

        var randomFirst = _firstPlayer == RandomFirst;
        var first = randomFirst ? Session.Random.Pick(Enumerable.Range(0, _names.Count).ToList()) : _firstPlayer;

        var seats = _names.Select((name, i) =>
        {
            var deck = _decks.FirstOrDefault(d => d.Id == _deckIds[i]);
            return new PlayerSeat(name, deck?.Id, deck?.Name, deck?.CoverImageUrl, _profileIds[i]);
        });

        var game = Game.Start(format, seats, first);
        if (randomFirst) game.Note($"{game.ActivePlayer.Name} was randomly chosen to go first.");
        await Session.StartAsync(game);
    }
}
