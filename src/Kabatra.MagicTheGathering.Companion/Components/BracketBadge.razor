@* A small "B3 · Upgraded" pill for a Commander deck's estimated bracket. Renders nothing for other formats. *@
@if (_assessment is { } a)
{
    <span class="bracket-badge b@(a.Number)" title="@($"Commander {a.Label}: {string.Join("; ", a.Reasons)}")">
        <span class="num">B@(a.Number)</span>@if (!Compact) { <span class="name">@a.Name</span> }
    </span>
}

@code {
    [Parameter, EditorRequired] public Deck Deck { get; set; } = default!;

    /// <summary>Shows only "B3", for tight spaces.</summary>
    [Parameter] public bool Compact { get; set; }

    private BracketAssessment? _assessment;

    protected override void OnParametersSet() => _assessment = CommanderBrackets.Assess(Deck);
}
