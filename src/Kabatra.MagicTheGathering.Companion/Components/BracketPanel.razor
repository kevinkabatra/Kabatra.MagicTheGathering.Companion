@* The deck page's Commander Bracket estimate, with the cards that set it. *@
<section class="bracket-panel b@(Assessment.Number)" aria-label="Commander bracket">
    <div class="row spread">
        <strong><span class="bracket-badge b@(Assessment.Number)"><span class="num">B@(Assessment.Number)</span></span> @Assessment.Label</strong>
        <button class="link small" @onclick="() => _open = !_open" aria-expanded="@_open">@(_open ? "Hide details" : "Why?")</button>
    </div>
    <p class="muted small">@CommanderBrackets.DescriptionOf(Assessment.Bracket)</p>

    @if (CanEdit)
    {
        <label class="field bracket-choice">
            <span class="small">Bracket</span>
            <select value="@(Deck.DeclaredBracket is { } d ? ((int)d).ToString() : "")" @onchange="ChooseAsync" aria-label="Bracket">
                <option value="">Estimate from the cards (Bracket @((int)Assessment.Estimated))</option>
                @foreach (var b in CommanderBrackets.Declarable)
                {
                    <option value="@((int)b)">Bracket @((int)b) · @CommanderBrackets.NameOf(b)</option>
                }
            </select>
        </label>
    }
    @if (Assessment.Declared is not null && !Assessment.IsDeclared)
    {
        <p class="error-text small">@Assessment.Reasons[0]. Showing the estimate instead.</p>
    }

    @if (_open)
    {
        <ul class="reasons">
            @foreach (var reason in Assessment.Reasons) { <li>@reason</li> }
        </ul>

        @if (Assessment.GameChangers.Count > 0)
        {
            <h4>Game Changers (@Assessment.GameChangers.Count)</h4>
            <p class="cards">@string.Join(", ", Assessment.GameChangers)</p>
        }
        @if (Assessment.MassLandDenial.Count > 0)
        {
            <h4>Mass land denial</h4>
            <p class="cards">@string.Join(", ", Assessment.MassLandDenial)</p>
        }
        @if (Assessment.Combos.Count > 0)
        {
            <h4>Two-card combos</h4>
            <ul class="cards">
                @foreach (var combo in Assessment.Combos)
                {
                    <li>@combo.First + @combo.Second: @combo.Result <span class="muted">(@(combo.IsEarly ? "early game" : "late game"), @combo.Cost mana)</span></li>
                }
            </ul>
        }
        @if (Assessment.ExtraTurns.Count > 0)
        {
            <h4>Extra turns (@Assessment.ExtraTurns.Count)</h4>
            <p class="cards">@string.Join(", ", Assessment.ExtraTurns)</p>
        }

        <p class="muted small">
            Brackets 2–4 are estimated from the Commander Brackets rules (updated @BracketCardLists.UpdatedOn.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)).
            Bracket 1 (Exhibition) and Bracket 5 (cEDH) depend on how a deck is meant to be played, so its owner chooses them.
            Exhibition only applies to a deck with no Game Changers, mass land denial, two-card combos or extra turns.
            Talk about your deck with your table before the game.
        </p>
    }
</section>

@code {
    [Parameter, EditorRequired] public BracketAssessment Assessment { get; set; } = default!;
    [Parameter, EditorRequired] public Deck Deck { get; set; } = default!;

    /// <summary>Whether the owner's choice of Bracket 1 or 5 can be changed here.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Called after the owner picks a bracket, so the page can re-rate the deck and mark it unsaved.</summary>
    [Parameter] public EventCallback OnChange { get; set; }

    private bool _open;

    private async Task ChooseAsync(ChangeEventArgs e)
    {
        Deck.DeclaredBracket = int.TryParse(e.Value?.ToString(), out var n) && CommanderBrackets.CanDeclare((CommanderBracket)n)
            ? (CommanderBracket)n
            : null;
        await OnChange.InvokeAsync();
    }
}
