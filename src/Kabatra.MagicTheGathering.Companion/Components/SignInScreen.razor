@* Shown in place of every page until the user signs in. Sign-in goes through an OAuth provider; there are no passwords. *@
@inject DeckLibrary Library

<PageTitle>Sign in · MTG Companion</PageTitle>

<div class="page sign-in">
    <header class="page-head center">
        <h1>MTG Companion</h1>
        <p class="muted">Life totals, decks, collections and play history for your playgroup.</p>
    </header>

    <section class="panel account">
        <h2>Sign in</h2>
        <p class="muted">Use an account you already have. We never see or store your password.</p>
        <div class="provider-buttons">
            @foreach (var provider in Library.Providers)
            {
                <button class="provider-button" type="button" disabled="@_busy" @onclick="() => SignInAsync(provider)">
                    <ProviderIcon Provider="@provider.Id" />
                    <span>Continue with @provider.Label</span>
                </button>
            }
        </div>
        <ErrorMessage />
    </section>
</div>

@code {
    private bool _busy;

    private async Task SignInAsync(AuthProvider provider)
    {
        _busy = true;
        try
        {
            await Library.SignInAsync(provider);
            // The browser is now leaving for the provider's page; keep the buttons disabled.
        }
        catch (DeckLibraryException)
        {
            _busy = false; // shown via Library.Error
        }
    }
}
