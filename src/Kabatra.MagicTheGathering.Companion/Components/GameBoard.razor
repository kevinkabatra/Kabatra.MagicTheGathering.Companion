@implements IDisposable
@inject GameSession Session
@inject PlayHistory History
@inject IJSRuntime Js

@if (Session.Current is { } game)
{
    <header class="topbar">
        <div class="turn">
            <span class="muted">Turn @game.TurnNumber</span>
            @if (game.Winner is { } winner)
            {
                <strong>🏆 @winner.Name wins!</strong>
                <span class="muted small">Start a new game to save this one to play history.</span>
            }
            else
            {
                <strong style="color:@game.ActivePlayer.Color">@game.ActivePlayer.Name</strong>
            }
        </div>
        <div class="actions">
            <button class="primary" @onclick="() => Session.UpdateAsync(g => g.NextTurn())" disabled="@(game.Winner is not null)">Next turn ▶</button>
            <button @onclick="() => Session.UpdateAsync(g => g.Undo())" disabled="@(!game.CanUndo)" title="Undo last change">↶ Undo</button>
            <button @onclick="() => Toggle(Panel.Dice)" class="@(_panel == Panel.Dice ? "on" : null)">🎲 Dice</button>
            <button @onclick="() => Toggle(Panel.Log)" class="@(_panel == Panel.Log ? "on" : null)">📜 Log</button>
            <button @onclick="NewGameAsync">New game</button>
        </div>
    </header>

    @if (_panel == Panel.Dice)
    {
        <DiceTray />
    }
    else if (_panel == Panel.Log)
    {
        <GameLog />
    }

    <main class="board players-@game.Players.Count">
        @foreach (var player in game.Players)
        {
            <PlayerCard @key="player.Id" Player="player" />
        }
    </main>
}

@code {
    private enum Panel { None, Dice, Log }
    private Panel _panel;

    // Player cards change the game without passing anything down to this component, so the turn,
    // winner and undo buttons up top need to hear about changes directly.
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private void Toggle(Panel panel) => _panel = _panel == panel ? Panel.None : panel;

    private async Task NewGameAsync()
    {
        // Avoid wiping a game in progress with one stray tap.
        if (Session.Current is not { } game) return;
        if (game.Winner is null)
        {
            var question = GameRecord.IsWorthRecording(game)
                ? "End this game and start a new one? It will be saved to play history with no winner."
                : "End this game and start a new one?";
            if (!await Js.InvokeAsync<bool>("confirm", question)) return;
        }
        // Saved on the device first, so the game isn't lost even if the playgroup can't be reached.
        await History.RecordAsync(game);
        await Session.EndAsync();
    }
}
